# Copy to .env.local and fill in from the deployed stack outputs:
#
#   aws cloudformation describe-stacks --stack-name PadiSsoPocStack \
#     --query "Stacks[0].Outputs" --output table
#
VITE_AWS_REGION=us-west-2
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# Required for sign-up, sign-in and password reset. This is the API ROOT — route paths
# such as /signup, /login or /me are appended to it.
#   deployed → https://api.global-np.padi.com/p/padi-auth-poc   (the ApiPublicUrl output)
#   local    → http://localhost:5080                            (the padisso-api launch config)
VITE_API_BASE_URL=

# Optional — enables the /magic-link page
VITE_REQUEST_MAGIC_LINK_URL=
VITE_VERIFY_MAGIC_LINK_URL=
